{
  "name": "firefly-grove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "node scripts/sync-android.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "c8 node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/junit.xml tests/*.test.mjs",
    "ci:validate": "node scripts/validate-ci.mjs",
    "pretest:coverage": "node scripts/prepare-test-reports.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "c8": {
    "all": true,
    "include": [
      "web/engine.js",
      "web/daily.js",
      "web/gestures.js",
      "aws-leaderboard/src/service.mjs",
      "aws-leaderboard/src/dynamo-store.mjs",
      "scripts/terraform-policy.mjs",
      "web/dialogs.js",
      "web/generator-protocol.js",
      "scripts/github-deploy-api.mjs",
      "web/profile.js",
      "web/hearts.js",
      "aws-leaderboard/src/journey.mjs",
      "web/hint-overlay.js",
      "web/firefly-player.js",
      "web/cloud.js",
      "web/cloud-state.js",
      "web/cloud-bridge.js"
    ],
    "reporter": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "check-coverage": true,
    "lines": 95,
    "statements": 95,
    "functions": 90,
    "branches": 85
  }
}
